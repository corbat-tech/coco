# Corbat-Coco Environment Configuration
# Copy this file to .env and fill in your API keys

# Default provider to use (anthropic, openai, gemini, kimi)
COCO_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-6.1-sol

# Google Gemini
GEMINI_API_KEY=your-key-here
# Alternative: GOOGLE_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.8-flash

# Kimi (Moonshot AI)
KIMI_API_KEY=your-key-here
# Alternative: MOONSHOT_API_KEY=your-key-here
KIMI_MODEL=kimi-k3
# Other options: kimi-k2-0324, kimi-latest, moonshot-v1-128k, moonshot-v1-32k, moonshot-v1-8k

# Optional: Custom base URLs (for proxies or alternative endpoints)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# KIMI_BASE_URL=https://api.moonshot.ai/v1  # Global (default)
# KIMI_BASE_URL=https://api.moonshot.cn/v1  # China

# xAI / MiniMax / Cerebras
# XAI_API_KEY=your-key-here
# MINIMAX_API_KEY=your-key-here
# CEREBRAS_API_KEY=your-key-here

# Azure OpenAI: endpoint + deployment; API key or Azure credential chain
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_MODEL=gpt-6.1-sol
# AZURE_OPENAI_API_KEY=your-key-here
# AZURE_OPENAI_AUTH_MODE=identity

# Amazon Bedrock: regional model access; AWS credential chain or bearer token
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile
# AWS_BEARER_TOKEN_BEDROCK=your-token-here
# AWS_BEDROCK_AUTH_MODE=identity
