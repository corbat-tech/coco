{
  "name": "@corbat-tech/coco",
  "version": "3.0.1",
  "description": "CLI coding agent and reusable runtime with tools, permissions, and review workflows",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "coco": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./tools": "./dist/tools/index.js",
    "./presets": "./dist/presets/index.js",
    "./adapters": "./dist/adapters/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:apps": "pnpm build && pnpm -r --filter './apps/*' --if-present typecheck",
    "lint": "oxlint src test",
    "lint:fix": "oxlint src test --fix",
    "format": "oxfmt --check src test",
    "format:fix": "oxfmt --write src test",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=4096' vitest",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage",
    "test:e2e": "NODE_OPTIONS='--max-old-space-size=4096' vitest run test/e2e",
    "test:repl": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --config vitest.repl.config.ts",
    "check:release": "node scripts/release-gate.mjs",
    "benchmark": "tsx test/benchmarks/quality-benchmark.ts",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "prepublishOnly": "pnpm build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "check:workspace": "pnpm check && pnpm typecheck:apps"
  },
  "keywords": [
    "ai",
    "agent",
    "coding",
    "autonomous",
    "development",
    "code-generation",
    "quality",
    "testing",
    "cli",
    "llm",
    "code-review",
    "code-quality",
    "self-review",
    "multi-agent",
    "convergence",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/corbat-tech/coco.git"
  },
  "homepage": "https://github.com/corbat-tech/coco#readme",
  "bugs": {
    "url": "https://github.com/corbat-tech/coco/issues"
  },
  "author": "Corbat",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1158.0",
    "@aws-sdk/credential-providers": "^3.1158.0",
    "@azure/identity": "^4.14.0",
    "@clack/prompts": "^1.8.1",
    "@google/genai": "2.31.0",
    "@typescript-eslint/typescript-estree": "^8.72.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ansi-escapes": "^7.3.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "execa": "^10.2.1",
    "glob": "^14.0.3",
    "highlight.js": "^11.12.0",
    "json5": "^2.2.3",
    "jsonrepair": "^3.15.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "minimatch": "^11.0.2",
    "openai": "^7.45.1",
    "ora": "^9.4.1",
    "simple-git": "^4.0.2",
    "string-width": "^8.3.0",
    "tslog": "^4.11.0",
    "undici": "^7.30.1",
    "wrap-ansi": "10.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
